<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.GestionePrenotazioniStaff">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="6ac77">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="36958" class="javax.swing.JTable" binding="tablePrenotazioni">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <grid id="dc18e" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="d45d8" class="javax.swing.JButton" binding="btnStatoButton">
            <constraints/>
            <properties>
              <text value="Modifica Stato"/>
            </properties>
          </component>
          <component id="e4a7" class="javax.swing.JButton" binding="btnCancella">
            <constraints/>
            <properties>
              <text value="Cancella"/>
            </properties>
          </component>
          <component id="dc092" class="javax.swing.JButton" binding="btnIndietro">
            <constraints/>
            <properties>
              <text value="Indietro"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
