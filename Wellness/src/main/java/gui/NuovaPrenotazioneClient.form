<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.NuovaPrenotazioneClient">
  <grid id="27dc6" binding="nuovaPrenotazionePanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="96c46" binding="scrollCorsi">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="29ca8" class="javax.swing.JTable" binding="tabellaLezioni">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <grid id="e47a3" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c27c3" class="javax.swing.JButton" binding="bntAnnulla">
            <constraints/>
            <properties>
              <text value="Annulla Operazione"/>
            </properties>
          </component>
          <component id="5c4e0" class="javax.swing.JButton" binding="bntAggiungi">
            <constraints/>
            <properties>
              <text value="Prenota Lezione"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
