<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.OrdiniClient">
  <grid id="27dc6" binding="ordiniClient" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="59bab" binding="scrollOrdini">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="d9467" class="javax.swing.JTable" binding="txtTabellaOrdini">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <grid id="4317f" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="6b347" class="javax.swing.JButton" binding="txtHome">
            <constraints/>
            <properties>
              <text value="Home"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
