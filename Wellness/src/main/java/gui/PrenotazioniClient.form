<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.PrenotazioniClient">
  <grid id="27dc6" binding="prenotazioniPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="afd5c" binding="sezioniPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="f2b4c" class="javax.swing.JButton" binding="bntHome">
            <constraints/>
            <properties>
              <text value="Home"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="b553c" binding="comandiPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="2">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c1cb6" class="javax.swing.JButton" binding="bntAnnullaPrenotazione">
            <constraints/>
            <properties>
              <text value="AnnullaPrenotazione"/>
            </properties>
          </component>
          <component id="7b327" class="javax.swing.JButton" binding="bntPrenota">
            <constraints/>
            <properties>
              <text value="AaggiungiPrenotazione"/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="62535" binding="scrollPrenotazioni">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="568ab" class="javax.swing.JTable" binding="tabellaPrenotazioni">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
